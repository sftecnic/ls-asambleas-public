{
  "name": "ls-asambleas",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:worker": "tsc -p tsconfig.worker.json",
    "worker:dry-run": "npx --cache .tools/npm-cache -y wrangler@4.152.0 deploy --config worker/wrangler.jsonc --dry-run",
    "setup": "node scripts/configure-installation.mjs",
    "setup:check": "node scripts/check-installation.mjs",
    "setup:resume": "node scripts/check-installation.mjs",
    "test:installation": "node --test tests/installation.test.mjs",
    "release:prepare": "node scripts/prepare-public-release.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "skills:check": "node scripts/skills.mjs check",
    "skills:restore": "node scripts/skills.mjs restore",
    "test:skills": "node --test tests/skills.test.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.1",
    "@photo-sphere-viewer/core": "5.15.1",
    "@photo-sphere-viewer/markers-plugin": "5.15.1",
    "@photo-sphere-viewer/visible-range-plugin": "5.15.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "firebase": "12.19.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
