# Copiar a .env.production.local para producción. No añadir claves privadas.
# El desarrollo sin estas variables usa exclusivamente datos ficticios locales.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=

# Servicio de reuniones, sin barra final.
VITE_MEETING_SERVICE_URL=
# Opcional: fotos y contactos departamentales en un Worker de lectura distinto.
# Vacío utiliza el servicio anterior. Actualizar el Worker antes de Hosting.
VITE_TOUR_SERVICE_URL=
